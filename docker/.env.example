# Aurel2 Docker Configuration
# Copy to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# INTERACTIVE BROKERS
# ===========================================

# Required: Your IB account credentials
TWS_USERID=your_ib_username
TWS_PASSWORD=your_ib_password

# Trading mode: paper or live
# IMPORTANT: This affects BOTH ib-gateway and aurel2
TRADING_MODE=paper

# IB Gateway port (inside container)
# 4004 = paper trading, 4003 = live trading
IBKR_PORT=4004

# API Settings
READ_ONLY_API=no

# Two-factor authentication handling
# restart = restart gateway after 2FA timeout (recommended for unattended)
TWOFA_TIMEOUT_ACTION=restart
RELOGIN_AFTER_TWOFA_TIMEOUT=yes

# What to do when another session is detected
# primary = take over the session (recommended)
EXISTING_SESSION_DETECTED_ACTION=primary

# Auto-restart time (handles daily IB maintenance window)
AUTO_RESTART_TIME=11:59 PM

# Timezone
TIME_ZONE=Europe/Bucharest

# VNC password for remote debugging (optional)
# Leave empty to disable VNC access
VNC_SERVER_PASSWORD=

# ===========================================
# AUREL2 TRADING DAEMON
# ===========================================

# Daily check time (HH:MM in your timezone)
CHECK_TIME=16:00

# Approval poll interval (minutes)
POLL_INTERVAL=5

# Dry run mode (true = simulate, don't execute trades)
DRY_RUN=false

# ===========================================
# AI SETTINGS
# ===========================================

# Claude model: sonnet (recommended), opus, or haiku
AI_MODEL=sonnet

# Failure pattern lookback (years)
# 3 years showed best results in backtests
AI_LOOKBACK_YEARS=3

# Path to Claude Code config (from your local machine)
# After running 'claude login' locally, copy ~/.claude to this path
CLAUDE_CONFIG_PATH=./claude-config

# ===========================================
# NOTIFICATIONS
# ===========================================

# Ntfy topic for push notifications
NTFY_TOPIC=aurel2

# ===========================================
# DASHBOARD (optional)
# ===========================================

# Dashboard port (only used with --profile dashboard)
DASHBOARD_PORT=8080
