# Aurel2 Docker Configuration
# Copy to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# ALPACA MARKETS
# ===========================================

# Required: Your Alpaca API credentials
# Get these from https://app.alpaca.markets/paper/dashboard/overview
APCA_API_KEY_ID=your_alpaca_api_key
APCA_API_SECRET_KEY=your_alpaca_api_secret

# Trading mode: paper or live
TRADING_MODE=paper

# ===========================================
# AUREL2 TRADING DAEMON
# ===========================================

# Daily check time in the market timezone
CHECK_TIME=10:30
MARKET_TIMEZONE=America/New_York

# Approval poll interval (minutes)
POLL_INTERVAL=5

# Dry run mode (true = simulate, don't execute trades)
DRY_RUN=false

# ===========================================
# AI SETTINGS
# ===========================================

# Claude model: sonnet (recommended), opus, or haiku
AI_MODEL=sonnet

# Failure pattern lookback (years)
# 3 years showed best results in backtests
AI_LOOKBACK_YEARS=3

# Path to Claude Code config (from your local machine)
# After running 'claude login' locally, copy ~/.claude to this path
CLAUDE_CONFIG_PATH=./claude-config

# ===========================================
# NOTIFICATIONS
# ===========================================

# Ntfy topic for push notifications
NTFY_TOPIC=aurel2

# ===========================================
# DASHBOARD (optional)
# ===========================================

# Dashboard port (only used with --profile dashboard)
DASHBOARD_PORT=8080
